# Copy the values you want into ~/.claude/.env  (NOT into this repo — never commit keys)
# Every key is optional; a missing key just disables one section of the brief.

# Where briefs are written: <vault>/inbox/research/morning-intel/
# Default if unset: ~/the-vault
AGENTIC_OS_VAULT=

# YouTube Radar section. Free:
# console.cloud.google.com -> new project -> enable "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# Optional. Lifts GitHub rate limits 60/hr -> 5000/hr for heavy re-running.
# github.com/settings/tokens -> classic token, NO scopes needed.
GITHUB_TOKEN=
