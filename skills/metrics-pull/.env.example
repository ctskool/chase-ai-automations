# Put these in ~/.claude/.env or set them as environment variables.
# Never put them in config.json or commit them.

# Required. Free: console.cloud.google.com -> new project -> enable
# "YouTube Data API v3" -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# Optional. Instagram follower count through the official Instagram API.
# Needs a professional (business or creator) account and an access token from
# a Meta developer app. Also set instagram.enabled to true in config.json.
INSTAGRAM_ACCESS_TOKEN=
