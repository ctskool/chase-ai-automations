# Copy this file to .env (next to SKILL.md) or set these in your shell.
# Leave a line blank if you don't use it. Never commit your real .env.

# Optional. Only used if yt-dlp can't get captions. Get one at apify.com (Settings > API & Integrations).
APIFY_API_TOKEN=

# Optional. Apify actor used for the fallback. Leave blank for the default (karamelo~youtube-transcripts).
APIFY_TRANSCRIPT_ACTOR=
